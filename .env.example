# Database
DB_HOST=localhost
DB_NAME=cancha_deportiva
DB_USER=root
DB_PASSWORD=
# Única cuenta que puede iniciar sesión y ver DNI, reservas y pagos.
PRIVATE_DATA_OWNER=admin@arena7.com
YAPE_PHONE=989518266

# External providers (set actual values as server environment variables)
RENIEC_TOKEN=
# Opcional en PHP para Windows si cURL no encuentra certificados CA. Guarde el archivo fuera del directorio web.
CA_BUNDLE_PATH=
RESEND_API_KEY=
MAIL_FROM=

# Pasarela QR independiente del Yape personal. Sin estas claves permanece desactivada.
# sandbox genera QR de prueba: no se puede pagar con Yape real.
TAYPI_MODE=sandbox
TAYPI_PUBLIC_KEY=
TAYPI_SECRET_KEY=
TAYPI_WEBHOOK_SECRET=
QR_AMOUNT_PEN=60.00
